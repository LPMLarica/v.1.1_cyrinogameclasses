# Texto com fim de linha normalizado
* text=auto
*.cs      text diff=csharp
*.md      text
*.txt     text eol=lf
*.json    text
*.py      text

# Arquivos YAML da Unity: merge cuidadoso
*.unity      text merge=unityyamlmerge eol=lf
*.prefab     text merge=unityyamlmerge eol=lf
*.asset      text merge=unityyamlmerge eol=lf
*.anim       text merge=unityyamlmerge eol=lf
*.controller text merge=unityyamlmerge eol=lf
*.mat        text merge=unityyamlmerge eol=lf
*.meta       text eol=lf

# Binários (para usar Git LFS: git lfs track "*.png" "*.wav" "*.ttf")
*.png binary
*.jpg binary
*.wav binary
*.ogg binary
*.mp3 binary
*.ttf binary
*.otf binary
